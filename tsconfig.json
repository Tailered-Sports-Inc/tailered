{
  "include": ["src/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "target": "ESNext",
    "strict": true,
    // The API boundary is deliberately untyped (see src/lib/trpc.ts, LAW 0):
    // the private router type is never vendored here, so callbacks over
    // API-returned data cannot be typed. noImplicitAny would flag every one of
    // those. Every other strict check (null checks, etc.) stays on.
    "noImplicitAny": false,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
